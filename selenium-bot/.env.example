# Базовый URL сайта (Docker: http://localhost:8081)
BASE_URL=http://localhost:8081

# Админ (login.html → admin.html)
ADMIN_PASSWORD=admin

# Тестовый оператор (фамилия + имя в модальном окне)
OPERATOR_LAST_NAME=Тестов
OPERATOR_FIRST_NAME=Бот
# Если в корневом .env заданы BENCH_OPERATOR_PIN и BENCH_REQUIRE_OPERATOR_PIN=1 —
# укажите тот же PIN здесь (обязательно для E2E).
#OPERATOR_PIN=

# KAO adapter (Web Serial / COM port name on Windows)
KAO_COM_PORT=COM8
KAO_BAUD=19200
KAO_CONNECT_TIMEOUT=90
# 1 = paramConnectAny (any USB, for COM8), 0 = filter KAO VID/PID only
KAO_USE_ANY_USB=1

# Order from 1C OData (must exist in 1C for current year)
TEST_ORDER_NUMBER=ТМ00-000001

# headless=1 — без окна браузера (0 — видимый режим)
HEADLESS=0

# Пошаговый лог в консоль (шаги + каждая проверка). Альтернатива: python run_bot.py -v
#VERBOSE=1

# Многократный запуск (или --repeat N)
#RUN_REPEAT=3
#REPEAT_INTERVAL=2
#STOP_ON_FAIL=1

# Пауза между шагами в визуальном режиме (сек)
STEP_PAUSE=1.2

# Таймаут ожидания элементов (сек)
IMPLICIT_WAIT=2
EXPLICIT_WAIT=15
