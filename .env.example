# Скопируйте в .env в корне проекта.

# --- OData 1С (заказ на производство) ---
# Базовый URL (если пусто — http://srv-1c/erp/odata/standard.odata)
#ODATA_1C_BASE=http://srv-1c/erp/odata/standard.odata

# IP сервера 1С — куда PHP из Docker ходит по TCP (вместо srv-1c в URL)
ODATA_1C_HOST_IP=172.22.0.52

# Заголовок Host для IIS при запросе по IP (имя публикации)
ODATA_1C_HTTP_HOST=srv-1c.tehnomer.ru

# LAN-имя в URL базы (по умолчанию srv-1c); заменяется на ODATA_1C_HOST_IP
#ODATA_1C_LAN_HOST=srv-1c

# Заменять любой LAN-хост на IP (не только srv-1c): 1 / true
#ODATA_1C_REPLACE_ANY_LAN_HOST=0

# Basic Auth (если не задано — можно указать в поле «База» на странице)
ODATA_1C_USER=odata_user
ODATA_1C_PASSWORD=secret

# Доп. хосты для клиентского base (через запятую). По умолчанию: srv-1c + ODATA_1C_* из .env
#ODATA_1C_ALLOWED_HOSTS=srv-1c.tehnomer.ru,172.22.0.52

# Google Таблица для страницы «Параметризация – счётчики»
#TM07_COUNTERS_SHEET_URL=https://docs.google.com/spreadsheets/d/…/edit

# --- Локальная БД производства (Firebird в Docker — рекомендуется) ---
FIREBIRD_HOST=firebird
FIREBIRD_DATABASE=/firebird/data/tm07_bench.fdb
FIREBIRD_USER=SYSDBA
# На производстве задайте сильный пароль (не masterkey) и тот же в ISC_PASSWORD compose.
FIREBIRD_PASSWORD=masterkey
FIREBIRD_CHARSET=UTF8

# Привязка портов nginx: 0.0.0.0 (LAN) или 127.0.0.1 (только этот ПК)
#TM07_BIND_HOST=0.0.0.0
# Один физический стенд без LAN — можно задать фиксированный код. Несколько ПК: не задавать (ID = fingerprint браузера WS…).
#TM07_WORKSTATION_CODE=bench-01
#TM07_WORKSTATION_NAME=Стенд параметризации №1

# Пароль администратора (обязателен; без него вход admin не создаётся)
ADMIN_PASSWORD=change-me-strong

# PIN операторов на стенде (обязательно на производстве).
# Общий запасной PIN (если у оператора ещё нет персонального в БД / списке ниже):
BENCH_OPERATOR_PIN=change-me-pin
# Персональные PIN: Фамилия:Имя:PIN через запятую (имя можно опустить: Иванов::4567)
# После первого входа PIN сохраняется в БД (hash) — дальше проверяется он.
#BENCH_OPERATOR_PINS=Иванов:Иван:4567,Петров:Пётр:8901
# 1 = запретить вход без настроенного PIN (обязательно в prod)
BENCH_REQUIRE_OPERATOR_PIN=1
# Selenium: тот же персональный/общий PIN в selenium-bot/.env как OPERATOR_PIN

# Токен Windows print-агента (обязателен при TM07_REQUIRE_PRINT_AGENT_TOKEN=1).
# Тот же — в env агента / C:\tm07-agent. Клиенту не отдаётся в action=config.
TM07_PRINT_AGENT_TOKEN=change-me-print-token
TM07_REQUIRE_PRINT_AGENT_TOKEN=1

# Ключи ЛКГ ТМ-07 (предпочтительно здесь, не в админке и не в JS).
# Если в data/device_settings.json пусто — подставляются из env.
# Формат: 4 байта через пробел, например AA BB CC DD (не коммитьте реальный ключ)
#TM07_SUPPLIER_LKG_HEX=
#TM07_MANUFACTURER_LKG_HEX=
# Алиас поставщика (то же значение):
#TM07_CORR_LKG_HEX=

# Windows / IBExpert (вне Docker): host.docker.internal + путь к .fdb
#FIREBIRD_HOST=host.docker.internal
#FIREBIRD_DATABASE=C:/Firebird/tm07_bench.fdb
